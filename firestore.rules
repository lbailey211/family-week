rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The only Google accounts allowed in. Keep this list the same as ALLOWED in index.html.
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['lbailey211@gmail.com', 'ektwoodward@gmail.com'];
    }

    function isValidEvent() {
      let e = request.resource.data;
      return e.keys().hasOnly(['date', 'slot', 'title', 'people', 'created', 'time', 'type'])
        && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && e.slot in ['morning', 'afternoon', 'evening']
        && e.title is string && e.title.size() > 0 && e.title.size() <= 80
        && e.people is list && e.people.size() >= 1 && e.people.size() <= 3
        && e.people.hasOnly(['Luke', 'Ellie', 'Frey'])
        && e.created is number
        && (!('time' in e) || (e.time is string && e.time.size() <= 20))
        && (!('type' in e) || e.type in ['work', 'fun']);
    }

    match /events/{eventId} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily() && isValidEvent();
    }
  }
}
